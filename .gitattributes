# Qualification reports bind the exact committed fixture bytes. Keep sanitized
# HTML fixtures byte-stable across Windows and Linux checkouts.
tests/fixtures/**/*.html text eol=lf

# Shell helpers execute inside Linux build stages even from Windows checkouts.
*.sh text eol=lf

# Only authenticated ciphertext is published here; decryption keys stay outside Git.
application-data/*.enc.part* filter=lfs diff=lfs merge=lfs -text

# Preserve CV PDF bytes across Windows and Linux checkouts
*.pdf -text
