# ── Job Agent connection ──────────────────────────────────────────────────────
# URL of your running job-agent API (no trailing slash)
JOB_AGENT_URL=http://localhost:8000

# Must match SECRET_KEY in your main .env
JOB_AGENT_TOKEN=change-me

# Refuse public/Vercel URLs by default: the bridge needs the private local API.
# Only set true for an intentionally secured private network endpoint.
ALLOW_NONLOCAL_AGENT_URL=false

# ── Group filtering ───────────────────────────────────────────────────────────
# "true"  = watch every group you are in
# "false" = only watch groups whose name matches GROUP_KEYWORDS
WATCH_ALL_GROUPS=false

# Comma-separated keywords (case-insensitive).
# Only used when WATCH_ALL_GROUPS=false.
GROUP_KEYWORDS=jobs,hiring,careers,work,tech,remote,vacancy,recruitment,opportunities

# WhatsApp Web compatibility. Leave blank to use the repository's known-good
# snapshot; pin only a version that passed your qualification run, and set the
# matching archive URL. Do not switch to an unqualified live snapshot.
WA_WEB_VERSION=
WA_WEB_VERSION_REMOTE_PATH=https://raw.githubusercontent.com/wppconnect-team/wa-version/main/html/2.2412.54.html

# "true" limits discovery to archived groups; group-name keywords still apply
# when WATCH_ALL_GROUPS=false.
WATCH_ARCHIVED_ONLY=false

# Read recent messages from eligible groups once at startup. URL bodies are
# processed in memory and only job-link records are sent to the local API.
ARCHIVE_SCAN_ON_START=false
ARCHIVE_SCAN_LIMIT=100
# After startup, repeat at most this many bounded cache scans after the delay.
# This helps WhatsApp hydrate archived windows without requesting unbounded
# history; message bodies remain in memory only.
ARCHIVE_RESCAN_DELAY_MS=30000
ARCHIVE_RESCAN_ATTEMPTS=2

# ── URL filtering ─────────────────────────────────────────────────────────────
# "true"  = only forward known job-board URLs (recommended)
# "false" = forward every URL found in watched groups
JOB_URL_ONLY=true

# ── Owner CV upload ───────────────────────────────────────────────────────────
# "true" = forward PDF documents sent directly (1:1 chat, not a group) to the
#          agent's /api/profile/resume endpoint, rebuilding your profile
FORWARD_OWNER_DOCS=false

# "true" = allow job links/text from explicitly allowlisted 1:1 chats.
# Keep this false unless you intentionally forward from a known self/recruiter
# chat; group ingestion is configured separately below.
FORWARD_DIRECT_MESSAGES=false
DIRECT_CHAT_NUMBERS=

# ── Outbound send endpoint ─────────────────────────────────────────────────────
# "true" = expose a local POST /send endpoint (127.0.0.1:SEND_PORT) that the
#          Python worker (worker/bridge_client.py) calls to send WhatsApp
#          messages/CVs. Guarded by the JOB_AGENT_TOKEN bearer.
ENABLE_SEND=false
SEND_PORT=8100

# ── Text-post forwarding ───────────────────────────────────────────────────────
# "true" = forward group messages with NO URL that match job-posting keywords
#          (e.g. "hiring", "vacancy") to the agent's /api/ingest-text endpoint
FORWARD_TEXT_POSTS=false

# HTTP timeout for forwarding a URL/text post to the API. Eager local
# extraction can take longer than ten seconds; the bridge still never retries
# an external application action.
AGENT_REQUEST_TIMEOUT_MS=60000

# ── Session & logging ─────────────────────────────────────────────────────────
# Where to save the WhatsApp session (relative to bridge/)
SESSION_DIR=./.wwebjs_auth

# info | verbose | silent
LOG_LEVEL=info
